{
  "version": 1,
  "status": "authoring",
  "identityReference": "../model/ronin-cat-side-style-reference-v3.png",
  "runtimeTarget": "../../rka_journey_storybook.riv",
  "composition": {
    "artboard": "Journey",
    "stateMachine": "Journey Controller",
    "viewModel": "Journey",
    "transparent": true,
    "fit": "contain"
  },
  "viewModel": {
    "activity": {
      "type": "enum",
      "values": [
        "journey",
        "idle",
        "meditating",
        "sleeping",
        "working",
        "reading",
        "training",
        "stretching",
        "teaBreak",
        "tired",
        "celebrating",
        "companion"
      ],
      "default": "journey"
    },
    "mood": {
      "type": "enum",
      "values": ["normal", "alert", "tired", "focused", "overwhelmed", "resolved"],
      "default": "normal"
    },
    "outfit": {
      "type": "enum",
      "values": ["base", "haori", "training", "journey"],
      "default": "journey"
    },
    "catState": {
      "type": "enum",
      "values": ["calm", "alert", "asleep", "watching", "concerned", "celebrating"],
      "default": "calm"
    },
    "progress": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0
    },
    "reducedMotion": {
      "type": "boolean",
      "default": false
    },
    "tap": {
      "type": "trigger"
    },
    "complete": {
      "type": "trigger"
    }
  },
  "rigFamilies": {
    "roninSide": {
      "nestedArtboard": "Ronin / Side",
      "source": "../reference/approved-storybook-v1/ronin-cat-side-neutral.png",
      "activities": ["journey", "idle"]
    },
    "roninFront": {
      "nestedArtboard": "Ronin / Front",
      "source": "../reference/approved-structural-v1/front-rig-approved.png",
      "activities": ["idle", "stretching", "celebrating"]
    },
    "roninRear": {
      "nestedArtboard": "Ronin / Rear",
      "source": "../reference/approved-structural-v1/rear-rig-corrected-approved.png",
      "activities": []
    },
    "roninSeated": {
      "nestedArtboard": "Ronin / Seated",
      "source": "../reference/approved-structural-v1/cross-legged-approved.png",
      "activities": ["meditating", "reading", "working", "teaBreak", "tired", "companion"]
    },
    "roninSleeping": {
      "nestedArtboard": "Ronin / Sleeping",
      "source": "../reference/approved-structural-v1/sleeping-approved.png",
      "activities": ["sleeping"]
    },
    "roninTraining": {
      "nestedArtboard": "Ronin / Training",
      "source": "../reference/approved-activities-v1/training-with-travel-gear-needs-correction.png",
      "sourceStatus": "pendingGearFreeReplacement",
      "activities": ["training"]
    },
    "catStanding": {
      "nestedArtboard": "Cat / Standing",
      "source": "../reference/approved-storybook-v1/cat-turnaround.png",
      "activities": ["journey", "idle", "training", "stretching"]
    },
    "catSeated": {
      "nestedArtboard": "Cat / Seated",
      "source": "../reference/approved-structural-v1/cross-legged-approved.png",
      "activities": ["meditating", "reading", "working", "teaBreak", "tired", "companion"]
    },
    "catSleeping": {
      "nestedArtboard": "Cat / Sleeping",
      "source": "../reference/approved-structural-v1/sleeping-approved.png",
      "activities": ["sleeping"]
    }
  },
  "activityReferences": {
    "journey": "../model/ronin-cat-side-style-reference-v3.png",
    "meditating": "../reference/approved-structural-v1/cross-legged-approved.png",
    "sleeping": "../reference/approved-structural-v1/sleeping-approved.png",
    "working": "../reference/approved-structural-v1/working-journaling-approved.png",
    "reading": "../reference/approved-activities-v1/reading-approved.png",
    "training": "../reference/approved-activities-v1/training-with-travel-gear-needs-correction.png",
    "stretching": "../reference/approved-activities-v1/stretching-with-travel-gear-concept.png",
    "teaBreak": "../reference/approved-activities-v1/tea-break-approved.png",
    "tired": "../reference/approved-activities-v1/tired-comfort-approved.png",
    "celebrating": "../reference/approved-structural-v1/celebration-approved.png",
    "companion": "../reference/approved-activities-v1/petting-cat-approved.png"
  },
  "modularSlots": {
    "face": ["eyeWhites", "irises", "pupils", "upperLids", "lowerLids", "brows", "mouth", "cheekTint"],
    "hair": ["hairBack", "head", "hairFront", "headbandBand", "headbandTailRear", "headbandTailFront"],
    "body": ["rearLimbs", "torso", "frontLimbs", "hands", "boots"],
    "outfit": ["innerTop", "outerTop", "sleeves", "wristWraps", "sash", "trousers", "footwear"],
    "travelGear": ["rearSword", "backpack", "bedroll", "backpackStraps", "frontSword"],
    "props": ["book", "journal", "brush", "cup", "bowl", "pillow", "cushion"],
    "cat": ["rearLegs", "tail", "body", "frontLegs", "head", "eyes", "lids", "mouth", "collar", "bell"]
  },
  "drawOrder": [
    "ronin.rearSword",
    "ronin.backpack",
    "ronin.hairBack",
    "ronin.rearLimbs",
    "ronin.torso",
    "ronin.frontLimbs",
    "ronin.head",
    "ronin.face",
    "ronin.hairFront",
    "ronin.headbandTails",
    "ronin.frontSword",
    "props",
    "cat.rearLegs",
    "cat.tail",
    "cat.body",
    "cat.frontLegs",
    "cat.head",
    "cat.face",
    "cat.collar"
  ],
  "motion": {
    "alwaysOn": ["roninBreath", "roninBlink", "catBreath", "catBlink", "catTail"],
    "reducedMotion": {
      "policy": "retainFunctionalMotion",
      "scale": 0.35,
      "speed": 0.55,
      "mustNeverBeStatic": true
    },
    "transitions": {
      "sameRigSeconds": 0.22,
      "crossRigSeconds": 0.32,
      "tapReactionSeconds": 0.62,
      "completionSeconds": 1.4
    }
  },
  "acceptance": [
    "Artboard background is fully transparent.",
    "Every state retains breathing, blinking or companion motion.",
    "Reduced Motion retains restrained functional feedback.",
    "Tap fires a visible reaction from every activity state.",
    "Completion can interrupt normal activity and returns cleanly.",
    "Backpack and sword never duplicate during rig swaps.",
    "Outfit changes preserve joint pivots and character proportions.",
    "Characters remain legible at the 164-point Home Journey size.",
    "React Native fallback remains available if Rive loading fails."
  ]
}
