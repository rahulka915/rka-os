rules_version = '2';

// Access rules: each user can only read/write their own backup snapshots. See apps/mobile/src/services/backupSync.ts
// for the collection shape (userId, deviceId, payload, createdAt).
service cloud.firestore {
  match /databases/{database}/documents {
    match /backups/{backupId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Real-time sync collections mirrored from local SQLite — see
    // apps/mobile/src/services/firestoreSync.ts. Each user can only read/write
    // their own subtree.
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && collection in ['items', 'itemInstances', 'itemRelations', 'itemOrder', 'appSettings', 'activityLogs'];
    }
  }
}
