rules_version = '2';

// Mirrors the RLS policy from the retired supabase/migrations/20260710120000_mobile_backups.sql:
// each user can only read/write their own backup snapshots. See apps/mobile/src/services/backupSync.ts
// for the collection shape (userId, deviceId, payload, createdAt).
service cloud.firestore {
  match /databases/{database}/documents {
    match /backups/{backupId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
  }
}
